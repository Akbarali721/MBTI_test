# --- Asosiy ---
# SQLAlchemy ulanish satri (lokalda: sqlite:///./mbti_dev.db)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mbti
# Sessiya cookie imzosi. Majburiy: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_RANDOM_48_BYTE_SECRET
# Productionʼda har doim false; true boʻlsa xavfsizlik tekshiruvlari faqat ogohlantiradi
DEBUG=true
# Foydalanuvchiga koʻrinadigan havolalar shu manzildan quriladi (deep link, natija URL)
PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- Admin panel ---
# 'admin' boʻlishi mumkin emas (DEBUG=false da ishga tushmaydi)
ADMIN_USERNAME=REPLACE_WITH_ADMIN_LOGIN
# Faqat lokal ishlash uchun: ochiq parol ishga tushishda hashlanadi. DEBUG=false da qabul qilinmaydi
ADMIN_PASSWORD=
# Bcrypt hash. Yaratish: python -c "from app.config import hash_password; print(hash_password('parol'))"
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH
# Bu yerdagi hisob — zaxira yoʻl (bazada qator yaratmaydi, har doim "egasi" huquqida).
# Qolgan adminlar bazada: /admin/users yoki `python -m app.admins create`.
# false qilishdan OLDIN bazada faol egani yarating, aks holda panelga kira olmaysiz.
ADMIN_ENV_LOGIN_ENABLED=true

# --- Telegram ---
# Kvitansiyalarni qabul qiladigan asosiy bot (@ belgisisiz)
BOT_USERNAME=your_bot
# @BotFather bergan token
BOT_TOKEN=
# Foydalanuvchi yordam soʻraydigan bot (@ belgisisiz)
PAYMENT_SUPPORT_BOT_USERNAME=your_support_bot
# Bot orqali toʻlovni tasdiqlaydigan asosiy admin Telegram ID (raqam)
ADMIN_TELEGRAM_ID=
# Bir nechta admin: vergul bilan ("111,222"). Yuqoridagi bitta ID bilan birlashtiriladi.
# Chek ularning HAMMASIGA yuboriladi. Bazadagi hisoblarning Telegram ID lari ham
# qoʻshiladi, lekin ular oʻz roli doirasida ishlaydi.
ADMIN_TELEGRAM_IDS=

# --- Savol toʻplamlari (A/B test) ---
# Bitta toʻplam: "A". Vaznli taqsimot: "A:70,B:30".
# Toʻplam sessiya yaratilganda bir marta tanlanadi va test davomida oʻzgarmaydi.
QUESTION_VARIANTS=A

# --- Premium toʻlov ---
# Premium narxi (soʻm)
PREMIUM_PRICE=9990
# Toʻlov qabul qilinadigan karta raqami
PAYMENT_CARD_NUMBER=0000000000000000
# Karta egasining ismi (toʻlov sahifasida koʻrsatiladi)
PAYMENT_CARD_HOLDER=KARTA EGASI ISMI

# --- Monitoring ---
# Boʻsh boʻlsa Sentry oʻchirilgan
SENTRY_DSN=
# Tracing namunasi ulushi: 0.0 dan 1.0 gacha
SENTRY_TRACES_SAMPLE_RATE=0.0
# Root logger darajasi: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# true boʻlsa uvicorn access log yoqiladi (yoʻlda natija tokeni koʻrinadi — ehtiyot boʻling)
ACCESS_LOG=false

# --- Xavfsizlik / sessiya ---
# true boʻlsa cookie faqat HTTPS orqali yuboriladi va HSTS sarlavhasi qoʻshiladi.
# Koʻrsatilmasa DEBUG boʻyicha aniqlanadi: production=true, lokal=false
# SECURE_COOKIES=true
# Admin sessiya cookie amal qilish muddati (sekund; standart 8 soat)
SESSION_MAX_AGE=28800
# X-Forwarded-* sarlavhalariga ishoniladigan proxy manzillari (vergul bilan; hammasi uchun: *)
TRUSTED_PROXIES=127.0.0.1
# Koʻrsatilmasa qatʼiy standart siyosat ishlatiladi (faqat /static manbalari).
# Faqat tashqi manba qoʻshish kerak boʻlganda toʻliq satrni yozing
# CONTENT_SECURITY_POLICY=default-src 'self'

# --- Bildirishnoma navbati ---
# Xabar toʻlov holati bilan bitta tranzaksiyada navbatga yoziladi, bot jarayonidagi
# ishchi uni yetkazadi. Holat: /admin/notifications
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_POLL_SECONDS=5
OUTBOX_BATCH_SIZE=5
# Band qilingan qator shu muddatdan keyin qaytariladi (jarayon oʻlsa yoʻqolmaydi)
OUTBOX_LEASE_SECONDS=180
# Shundan uzoq kutgan xabar admin panelida ogohlantirish sifatida koʻrinadi
OUTBOX_OVERDUE_MINUTES=15

# --- Eksport ---
# CSV eksportdagi qatorlar chegarasi; oshsa sana oraligʻini toraytirish soʻraladi
EXPORT_MAX_ROWS=50000

# --- Maʼlumotlarni saqlash muddati (kun) ---
# 0 = qoida OʻCHIRILGAN. Manfiy qiymat qabul qilinmaydi.
# Toʻlovi, jamoa aʼzoligi yoki premiumi bor sessiyaga hech bir qoida tegmaydi.
# Bajarish: python -m app.retention --apply  (koʻrish uchun: /admin/retention)
#
# Boshlanmagan sessiyalar oʻchiriladi (avval kunlik agregatga yigʻiladi)
RETENTION_VISITED_DAYS=30
# Tashlab ketilgan sessiyalar anonimlashtiriladi — qator hisobotda qoladi
RETENTION_INCOMPLETE_DAYS=90
# Yakunlangan bildirishnomalar oʻchiriladi; yuborilmagani hech qachon oʻchirilmaydi
RETENTION_OUTBOX_DAYS=30
# Auditning oddiy yozuvlari; pul va rol qarorlari hech qachon tozalanmaydi
RETENTION_AUDIT_DAYS=730

# --- Rate limit ---
# false boʻlsa soʻrov cheklovlari oʻchiriladi (lokal test uchun)
RATE_LIMIT_ENABLED=true
# Admin login uchun cheklov (brute-forceʼga qarshi). Hozircha cheklov faqat
# shu endpointga qoʻllanadi — global throttling yoʻq.
RATE_LIMIT_LOGIN=5/minute
# AI maslahat soʻrovi (IP boʻyicha): tashqi chaqiruv pullik
RATE_LIMIT_AI_ADVICE=10/hour
# slowapi saqlagichi: memory:// yoki redis://host:port
RATE_LIMIT_STORAGE_URI=memory://

# --- Referal: doʻst taklif qilib bepul premium olish ---
# Havola sifatida natijaning mavjud ulashish kodi ishlatiladi:
#   PUBLIC_BASE_URL/personality?ref=<ulashish-kodi>
# false boʻlsa blok koʻrsatilmaydi va mukofot berilmaydi
REFERRAL_ENABLED=true
# Shuncha taklif qilingan odam testni TUGATSA bitta mukofot beriladi
REFERRAL_REQUIRED_COMPLETIONS=3
# Har mukofot shuncha kunga premium ochadi (muddat uzayadi, boshidan boshlanmaydi)
REFERRAL_REWARD_DAYS=3
# Yigʻilgan bepul muddat chegarasi — mukofot takrorlanadigan boʻlgani uchun kerak
REFERRAL_MAX_REWARD_DAYS=30

# --- AI maslahatlar (premium boʻlimi) ---
# Kalit boʻsh boʻlsa funksiya BUTUNLAY oʻchadi va tugma koʻrinmaydi.
# Soʻrovda shaxsiy maʼlumot yoʻq: faqat MBTI tipi va oʻlchov foizlari yuboriladi.
AI_API_KEY=
AI_BASE_URL=https://api.anthropic.com
AI_MODEL=claude-sonnet-5
# Nechta maslahat soʻraladi (kam kelsa javob rad etiladi)
AI_ADVICE_COUNT=5
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=1500
# Kunlik chegara — bir kunda nechta SESSIYAga javob yaratiladi (Toshkent kuni).
# Eng yomon holatda chaqiruvlar soni AI_DAILY_LIMIT * AI_MAX_ATTEMPTS ga teng.
AI_DAILY_LIMIT=200
# Bitta sessiya uchun urinishlar soni (xatodan keyin qayta bosish)
AI_MAX_ATTEMPTS=3
